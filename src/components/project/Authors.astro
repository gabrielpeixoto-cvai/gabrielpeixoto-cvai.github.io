---
interface Author { name: string; affiliation?: string | string[]; url?: string; }
interface Props { authors: Author[]; }
const { authors } = Astro.props;

const affOf = (a: Author): string[] =>
  a.affiliation == null ? [] : Array.isArray(a.affiliation) ? a.affiliation : [a.affiliation];

// Assign each distinct affiliation a stable superscript number. Number each
// author's primary (first) affiliation first, in author order, then any
// remaining affiliations, so the list follows the usual author-block order.
const affiliations: string[] = [];
const add = (aff?: string) => {
  if (aff && !affiliations.includes(aff)) affiliations.push(aff);
};
for (const a of authors) add(affOf(a)[0]);
for (const a of authors) for (const aff of affOf(a)) add(aff);
const numbersOf = (a: Author) =>
  affOf(a).map((aff) => affiliations.indexOf(aff) + 1).join(',');
---
<p style="margin:.5rem 0;">
  {authors.map((a, i) => (
    <span>
      {a.url
        ? <a href={a.url} target="_blank" rel="noopener noreferrer">{a.name}</a>
        : <span>{a.name}</span>}
      {affOf(a).length > 0 && <sup>{numbersOf(a)}</sup>}
      {i < authors.length - 1 && <span>, </span>}
    </span>
  ))}
</p>
{affiliations.length > 0 && (
  <p style="color:var(--muted);font-size:.9rem;margin:.25rem 0;">
    {affiliations.map((aff, i) => (
      <span><sup>{i + 1}</sup>{aff}{i < affiliations.length - 1 && <span>; </span>}</span>
    ))}
  </p>
)}
